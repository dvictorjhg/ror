<div class="row justify-content-center">
    <div class="card">
      <div class="card-header">
        <h2 class="mb-0"><%= t('search.title') %></h2>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-4 mb-3">
            <div class="card h-100">
              <div class="card-body text-center">
                <h3><%= t('search.by_text') %></h3>
                <p><%= t('search.text_description') %></p>
                <%= link_to t('search.start_search'), text_searches_path, class: "btn btn-primary" %>
              </div>
            </div>
          </div>
          
          <div class="col-md-4 mb-3">
            <div class="card h-100">
              <div class="card-body text-center">
                <h3><%= t('search.by_category') %></h3>
                <p><%= t('search.category_description') %></p>
                <%= link_to t('search.start_search'), category_searches_path, class: "btn btn-primary" %>
              </div>
            </div>
          </div>
          
          <div class="col-md-4 mb-3">
            <div class="card h-100">
              <div class="card-body text-center">
                <h3><%= t('search.random') %></h3>
                <p><%= t('search.random_description') %></p>
                <%= link_to t('search.start_search'), random_searches_path, class: "btn btn-primary" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
</div>
